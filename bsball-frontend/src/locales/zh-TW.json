      },
      "gdp": {
        "fullName": "滚地造成双杀",
        "definition": "打者击出滚地球并导致守方完成双杀（或多重出局）",
        "shortLabel": "GDP"
      },
      "gidp": {
        "fullName": "滚地造成双杀",
        "definition": "打者击出滚地球并导致守方完成双杀（或多重出局）",
        "shortLabel": "GIDP"
      },
      "goFo": {
        "fullName": "滚地出局 / 飞球出局比",
        "definition": "打者滚地出局与飞球出局的比值",
        "shortLabel": "GOFO"
      },
      "goAo": {
        "fullName": "滚地出局 / 飞球出局比",
        "definition": "打者滚地出局与飞球出局的比值",
        "shortLabel": "滾飛出局比"
      },
      "xbh": {
        "fullName": "长打数",
        "definition": "除一垒安打外的安打总数",
        "shortLabel": "長打數"
      },
      "tb": {
        "fullName": "垒打数",
        "definition": "打者通过安打累计获得的总垒包数",
        "shortLabel": "壘打數"
      },
      "babip": {
        "fullName": "场内球打击率",
        "definition": "仅统计进入场内的击球结果，排除全垒打与三振后的打击率指标",
