        "shortLabel": "失誤"
      },
      "dp": {
        "fullName": "双杀",
        "definition": "守备方在同一连贯守备中完成两人出局",
        "shortLabel": "雙殺"
      },
      "pb": {
        "fullName": "捕逸",
        "definition": "應可由捕手以一般守備處理的合法投球漏接，並造成打者或跑者推進",
        "shortLabel": "捕逸"
      },
      "catcherCs": {
        "fullName": "盜壘阻殺",
        "definition": "捕手對企圖盜壘的跑者完成刺殺出局的次數",
        "shortLabel": "阻殺"
      },
      "tcPct": {
        "fullName": "守备率",
        "definition": "守备员在守备机会中不发生失误的比率",
        "shortLabel": "守備率"
      },
      "sb": {
        "fullName": "盗垒",
        "definition": "跑者在非安打、失误等情形下，自行成功推进一个垒包",
        "shortLabel": "盜壘"
      },
      "cs": {
        "fullName": "盗垒失败",
        "definition": "跑者尝试盗垒时在到达下一垒前被刺杀出局",
        "shortLabel": "盜失"
      },
      "avg": {
        "fullName": "打击率",
        "definition": "每打数获得安打的比率",
        "shortLabel": "打擊率"
      },
      "obp": {
        "fullName": "上垒率",
        "definition": "打者在打席中成功上垒的比率",
        "shortLabel": "上壘率"
      },
      "slg": {
        "fullName": "长打率",
        "definition": "每打数可获得的平均垒打数",
        "shortLabel": "長打率"
      },
      "ops": {
        "fullName": "攻击指数",
        "definition": "上垒率与长打率之和",
        "shortLabel": "攻擊指數"
      },
      "opsPlus": {
        "fullName": "调整后 OPS",
        "definition": "校正联盟与球场环境后的 OPS 指标，100 为联盟平均",
        "shortLabel": "OPS+"
      },
      "bipPct": {
        "fullName": "场内球比例",
        "definition": "打席结果为场内击球（非三振、保送、触身等）的比例",
        "shortLabel": "BIP%"
      }
    }
  },
