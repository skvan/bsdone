        "shortLabel": "ISO"
      },
      "abHr": {
        "fullName": "每轰打数",
        "definition": "打者平均每击出一支全垒打所需的打数",
        "shortLabel": "ABHR"
      },
      "bbK": {
        "fullName": "保送/三振比",
        "definition": "打者保送次数与三振次数的比值",
        "shortLabel": "BBK"
      },
      "bbPct": {
        "fullName": "保送率",
        "definition": "打者在打席中获得保送的比例",
        "shortLabel": "BB%"
      },
      "kPct": {
        "fullName": "三振率",
        "definition": "打者在打席中被三振的比例",
        "shortLabel": "K%"
      },
      "fip": {
        "fullName": "独立防御率",
        "definition": "以投手可较稳定主导的结果（全垒打、保送、触身、三振）估算失分能力",
        "shortLabel": "FIP"
      },
      "eraPlus": {
        "fullName": "调整后防御率",
