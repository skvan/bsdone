        "shortLabel": "QS"
      },
      "gf": {
        "fullName": "终结出赛",
        "definition": "投手作为球队该场最后登板投手（且非先发）时记一场",
        "shortLabel": "GF"
      },
      "pitchR": {
        "fullName": "失分",
        "definition": "投手失分总数（含自责与非自责）",
        "shortLabel": "失分"
      },
      "er": {
        "fullName": "自责分",
        "definition": "投手应负责任的失分",
        "shortLabel": "自責"
      },
      "era": {
        "fullName": "自责分率",
        "definition": "投手每九局平均自责分",
        "shortLabel": "自責分率"
      },
      "whip": {
        "fullName": "每局被上垒率",
