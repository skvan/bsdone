      },
      "inn": {
        "fullName": "守备局数",
        "definition": "球员在对应守位完成防守的总局数",
        "shortLabel": "守備局數"
      },
      "tc": {
        "fullName": "守备机会",
        "definition": "总守备机会数（接杀 + 助杀 + 失误）",
        "shortLabel": "守備機會"
      },
      "po": {
        "fullName": "接杀",
        "definition": "守备员直接完成出局时记一接杀",
        "shortLabel": "接殺"
      },
      "a": {
        "fullName": "助杀",
        "definition": "守备员传球或处理球并协助完成出局时记一助杀",
        "shortLabel": "助殺"
      },
      "e": {
        "fullName": "失误",
