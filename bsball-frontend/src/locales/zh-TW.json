        "shortLabel": "敗場"
      },
      "gs": {
        "fullName": "先发场次",
        "definition": "该投手作为球队首位登板投手的场次",
        "shortLabel": "先發"
      },
      "cg": {
        "fullName": "完投",
        "definition": "先发投手从开局投到比赛结束且中途未被替换",
        "shortLabel": "完投"
      },
      "pg": {
        "fullName": "完封",
        "definition": "投手完投且未失分",
        "shortLabel": "PG"
      },
      "sho": {
        "fullName": "完封",
        "definition": "投手完投且未失分",
        "shortLabel": "完封"
      },
      "sv": {
        "fullName": "救援成功",
        "definition": "后援投手在符合救援条件下守住胜利所记的成绩",
        "shortLabel": "救援成功"
      },
      "svo": {
        "fullName": "救援机会",
        "definition": "投手登板时具备可获得救援成功条件的次数",
        "shortLabel": "救援機會"
      },
      "ip": {
        "fullName": "投球局数",
        "definition": "投手在场时制造出局数除以 3；.1 代表 1/3 局，.2 代表 2/3 局",
        "shortLabel": "投球局數"
      },
      "tbf": {
        "fullName": "面对打者总数",
        "definition": "投手面对打者的总人次",
        "shortLabel": "TBF"
      },
      "bf": {
        "fullName": "面对打者",
        "definition": "投手面对打者的总人次",
        "shortLabel": "BF"
      },
      "pitchBf": {
        "fullName": "面对打者",
        "definition": "投手面对打者的总人次",
        "shortLabel": "打席"
      },
      "np": {
        "fullName": "投球数",
        "definition": "投手投出的总球数",
        "shortLabel": "投球數"
      },
      "pIp": {
        "fullName": "每局用球数",
        "definition": "投手每局平均投球数",
        "shortLabel": "PIP"
      },
      "qs": {
        "fullName": "优质先发",
