      },
      "so9": {
        "fullName": "每九局三振",
        "definition": "投手每九局平均三振数",
        "shortLabel": "K9值"
      },
      "bb9": {
        "fullName": "每九局保送",
        "definition": "投手每九局平均保送数",
        "shortLabel": "B9值"
      },
      "h9": {
        "fullName": "每九局被安打",
        "definition": "投手每九局平均被安打数",
        "shortLabel": "H9值"
      },
      "kBb": {
        "fullName": "三振保送比",
        "definition": "投手三振次数与保送次数的比值",
        "shortLabel": "保送三振比"
      },
      "avgAgainst": {
        "fullName": "被打击率",
        "definition": "对手面对该投手时的打击率",
        "shortLabel": "被打擊率"
      },
      "sbAllowed": {
        "fullName": "被盗垒",
        "definition": "投手在场时被跑者盗垒成功的总次数",
        "shortLabel": "SBALLOWED"
      },
      "csAllowed": {
        "fullName": "盗垒刺杀",
        "definition": "投手在场时对方跑者盗垒被刺杀总次数",
        "shortLabel": "CSALLOWED"
      },
      "pk": {
        "fullName": "牵制出局",
