    "term": {
      "pa": {
        "fullName": "打席",
        "definition": "球员完成打席的次数",
        "shortLabel": "打席"
      },
      "gp": {
        "fullName": "出场场次",
        "definition": "球员出赛（上场）过的比赛场次",
        "shortLabel": "場次"
      },
      "g": {
        "fullName": "出场",
        "definition": "投手至少投出一球即记为出场一场",
        "shortLabel": "出賽"
      },
      "ab": {
        "fullName": "打数",
        "definition": "不包含保送、触身球、牺牲打、妨碍上垒等结果的打席次数",
        "shortLabel": "打數"
      },
      "oneB": {
        "fullName": "一垒安打",
        "definition": "打者凭安打安全上到一垒",
        "shortLabel": "一安"
      },
      "r": {
        "fullName": "得分",
        "definition": "跑者安全返回本垒并完成得分",
        "shortLabel": "得分"
      },
      "h": {
        "fullName": "安打",
        "definition": "打者击出界内球并安全上垒，且非失误或野手选择所致",
        "shortLabel": "安打"
      },
      "pitchH": {
        "fullName": "被安打",
        "definition": "投手被击出的安打数",
        "shortLabel": "被安打"
      },
      "twoB": {
        "fullName": "二垒安打",
        "definition": "打者凭安打安全上到二垒",
        "shortLabel": "二安"
      },
      "threeB": {
        "fullName": "三垒安打",
        "definition": "打者凭安打安全上到三垒",
        "shortLabel": "三安"
      },
      "hr": {
        "fullName": "全垒打",
        "definition": "打者击球后依序通过一二三垒并回本垒得分，过程中未被刺杀且非因守备失误受益",
        "shortLabel": "全壘打"
      },
      "iphr": {
        "fullName": "場內全壘打",
        "definition": "球未飛越全壘打牆仍跑回本壘得分",
        "shortLabel": "場內全壘打"
      },
      "pitchHr": {
        "fullName": "被全垒打",
        "definition": "投手被击出的全垒打数",
        "shortLabel": "被全壘打"
      },
      "pitchInsideParkHr": {
        "fullName": "被場內全壘打",
        "definition": "投手被擊出的場內全壘打次數",
        "shortLabel": "被場內全壘打"
      },
      "rbi": {
        "fullName": "打点",
        "definition": "因打者该次打席行为而带回的得分",
        "shortLabel": "打點"
      },
      "bb": {
        "fullName": "保送",
        "definition": "投手四坏球或故意保送，打者被判上一垒",
        "shortLabel": "保送"
      },
      "pitchBb": {
        "fullName": "投手保送",
        "definition": "投手给予打者的保送次数",
        "shortLabel": "保送"
      },
      "ibb": {
        "fullName": "故意四坏",
        "definition": "打者被故意保送的次数",
        "shortLabel": "故四"
      },
      "hbp": {
        "fullName": "触身球",
        "definition": "打者未尝试击球时被投球击中，并被裁定上一垒",
        "shortLabel": "觸身"
      },
      "hb": {
        "fullName": "触身球（投手）",
        "definition": "投手投球击中未尝试挥棒的打者",
        "shortLabel": "HB"
      },
      "so": {
        "fullName": "三振",
        "definition": "打者在一个打席中被判三次好球而出局",
        "shortLabel": "三振"
      },
      "pitchSo": {
        "fullName": "夺三振",
        "definition": "投手让打者累积三好球（挥空或目送）而出局",
        "shortLabel": "奪三振"
      },
      "w": {
        "fullName": "胜投",
        "definition": "球队取得并保持领先时对应的投手可记胜投（依官方记分规则裁定）",
        "shortLabel": "勝場"
      },
      "l": {
        "fullName": "败投",
